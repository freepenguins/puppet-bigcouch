#!/usr/bin/make -f
# Builds BigCouch 0.4.2b into /opt/bigcouch: couchjs with SCons (Python 2
# and Erlang/OTP R16B03-1 are first on PATH, from build.sh), the Erlang
# applications with rebar, and a self-contained release with rebar generate.

# What `git describe --match 1.*` gives at the bigcouch-0.4.2b tag; the couch
# application and couchjs -V report it.
VSN = 1.1.1-788-gf0f5a10
export BIGCOUCH_VSN = $(VSN)

# The 2011-2013 C code on GCC 12 and 14. couchjs is compiled as C++.
export DEB_CFLAGS_MAINT_APPEND = -fcommon -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion
export DEB_CXXFLAGS_MAINT_APPEND = -fpermissive
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_configure:
	# What ./configure writes, without its `rebar get-deps` (the
	# dependencies are already in deps/).
	printf '%s\n' \
	  '{prefix, "/opt/bigcouch"}.' \
	  '{data_dir, "/var/lib/bigcouch"}.' \
	  '{view_dir, "/var/lib/bigcouch"}.' \
	  '{user, "bigcouch"}.' \
	  '{node_name, "-name bigcouch"}.' \
	  '{cluster_port, 5984}.' \
	  '{cluster_ssl, 6984}.' \
	  '{backend_port, 5986}.' > rel/bigcouch.config
	mkdir -p apps/couch/ebin

override_dh_auto_build:
	cd couchjs && CPPPATH=/usr/include/js python scons/scons.py
	./rebar compile
	sed -i 's/%VSN%/$(VSN)/' apps/couch/ebin/couch.app
	rm -rf rel/bigcouch
	./rebar generate

override_dh_auto_test:

override_dh_auto_install:
	mkdir -p debian/bigcouch/opt
	cp -a rel/bigcouch debian/bigcouch/opt/bigcouch
	# Logs go to /var/log/bigcouch and configuration to /etc/bigcouch.
	rm -rf debian/bigcouch/opt/bigcouch/var
	sed -i 's#-args_file $$ROOTDIR/etc/vm.args#-args_file /etc/bigcouch/vm.args#' debian/bigcouch/opt/bigcouch/bin/bigcouch
	grep -q -- '-args_file /etc/bigcouch/vm.args' debian/bigcouch/opt/bigcouch/bin/bigcouch
	sed -i 's#^file = /opt/bigcouch/var/log/bigcouch.log#file = /var/log/bigcouch/bigcouch.log#' debian/bigcouch/opt/bigcouch/etc/default.ini
	# Defaults the postinst copies to /etc/bigcouch when it has none.
	install -m 0644 debian/vm.args debian/bigcouch/opt/bigcouch/etc/vm.args
	install -m 0644 debian/local.ini debian/bigcouch/opt/bigcouch/etc/local.ini

# The bundled Erlang's own binaries; nothing for a -dbgsym package.
override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:

override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
