mochiweb: build its parameterized modules on Erlang R16

R16 dropped parameterized modules, which mochiweb's request, response
and format modules are. pmod_transform's parse transform (installed
in the build toolchain by inside.sh) turns them into ordinary modules that
behave the same.

diff -ru a/deps/mochiweb/src/mochifmt_records.erl b/deps/mochiweb/src/mochifmt_records.erl
--- a/deps/mochiweb/src/mochifmt_records.erl
+++ b/deps/mochiweb/src/mochifmt_records.erl
@@ -10,6 +10,7 @@
 %%    foo
 
 -module(mochifmt_records, [Recs]).
+-compile({parse_transform, pmod_pt}).
 -author('bob@mochimedia.com').
 -export([get_value/2]).
 
diff -ru a/deps/mochiweb/src/mochifmt_std.erl b/deps/mochiweb/src/mochifmt_std.erl
--- a/deps/mochiweb/src/mochifmt_std.erl
+++ b/deps/mochiweb/src/mochifmt_std.erl
@@ -4,6 +4,7 @@
 %% @doc Template module for a mochifmt formatter.
 
 -module(mochifmt_std, []).
+-compile({parse_transform, pmod_pt}).
 -author('bob@mochimedia.com').
 -export([format/2, get_value/2, format_field/2, get_field/2, convert_field/2]).
 
diff -ru a/deps/mochiweb/src/mochiweb_request.erl b/deps/mochiweb/src/mochiweb_request.erl
--- a/deps/mochiweb/src/mochiweb_request.erl
+++ b/deps/mochiweb/src/mochiweb_request.erl
@@ -4,6 +4,7 @@
 %% @doc MochiWeb HTTP Request abstraction.
 
 -module(mochiweb_request, [Socket, Method, RawPath, Version, Headers]).
+-compile({parse_transform, pmod_pt}).
 -author('bob@mochimedia.com').
 
 -include_lib("kernel/include/file.hrl").
diff -ru a/deps/mochiweb/src/mochiweb_response.erl b/deps/mochiweb/src/mochiweb_response.erl
--- a/deps/mochiweb/src/mochiweb_response.erl
+++ b/deps/mochiweb/src/mochiweb_response.erl
@@ -4,6 +4,7 @@
 %% @doc Response abstraction.
 
 -module(mochiweb_response, [Request, Code, Headers]).
+-compile({parse_transform, pmod_pt}).
 -author('bob@mochimedia.com').
 
 -define(QUIP, "Any of you quaids got a smint?").
